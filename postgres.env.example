# Copy to postgres.env and set real passwords. Do not commit postgres.env.
# Used by docker-compose.db.yml (env_file on db-init, db-replica, pgweb).
# For path/publish overrides via compose interpolation, use ./scripts/db-compose.sh instead.

POSTGRES_USER=crm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=crm
REPLICATION_PASSWORD=changeme

PGDATA_PRIMARY=/mnt/data_main/m2solution_crm/pgdata
PGDATA_REPLICA=/mnt/data_backup/m2solution_crm/pgdata

# Host publishes (LAN + WireGuard + localhost). CRM apps use hostname db on network shared-db.
POSTGRES_PUBLISH_LAN=192.168.2.99:5432
POSTGRES_PUBLISH_WG=10.50.0.2:5432

# Comma-separated databases created by db-init (POSTGRES_DB is created on first cluster init).
POSTGRES_EXTRA_DATABASES=crm_dev,cooking_main,cooking_dev

# pgweb UI — LAN only (not WireGuard). HTTP basic auth, then auto-connect to POSTGRES_DB.
# Switch databases from the pgweb sidebar (same Postgres instance). Do not set PGWEB_LOCK_SESSION or PGWEB_SESSIONS.
PGWEB_PUBLISH=192.168.2.99:8085
PGWEB_AUTH_USER=admin
PGWEB_AUTH_PASS=changeme
