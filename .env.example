# Copy to .env and set real SECRET_KEY. Do not commit .env.
# Database cluster settings live in postgres.env (see postgres.env.example).

SECRET_KEY=change-me
POSTGRES_USER=crm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=crm
DEV_POSTGRES_DB=crm_dev

# Staff file manager blobs (not in Postgres; not copied by the replica).
FILES_ROOT=/mnt/data_main/m2solution_crm/files
DEV_FILES_ROOT=/mnt/data_main/m2solution_crm/files_dev
FILES_MAX_BYTES=25000000

# Prod (docker-compose.yml). WireGuard-only; VPS nginx → 10.50.0.2:8081.
# Host 8080 is Pterodactyl Wings on this machine.
PUBLIC_APP_URL=https://crm.m2solution.ca
CORS_ORIGINS=https://crm.m2solution.ca
PROD_WEB_PUBLISH=10.50.0.2:8081

# Dev (docker-compose.dev.yml). Same Postgres instance as prod, database
# DEV_POSTGRES_DB. URLs stay local. SSH: -L 5173:127.0.0.1:5173
# Start shared-db stack before CRM: docker compose -f docker-compose.db.yml up -d
DEV_PUBLIC_APP_URL=http://localhost:5173
DEV_CORS_ORIGINS=http://localhost:5173
SEED_EMAIL=admin@m2solution.com
SEED_PASSWORD=changeme
COMPANY_NAME="M2 Solution"
COMPANY_EMAIL=billing@m2solution.com
COMPANY_ADDRESS=
COMPANY_PHONE=

# Google OAuth (staff sign-in). Create the client in Google Cloud Console.
# Leave empty to disable the button path (API returns 503 on /api/auth/google/start).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI on the OAuth client.
# Prod: https://crm.m2solution.ca/auth/google/callback
# Dev (Vite proxies /api → backend): http://localhost:5173/api/auth/google/callback
GOOGLE_REDIRECT_URI=
