# Copy to .env and set real SECRET_KEY / POSTGRES_PASSWORD. Do not commit .env.

SECRET_KEY=change-me
POSTGRES_USER=crm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=crm
DEV_POSTGRES_DB=crm_dev
REPLICATION_PASSWORD=changeme
PGDATA_PRIMARY=/mnt/data_main/m2solution_crm/pgdata
PGDATA_REPLICA=/mnt/data_backup/m2solution_crm/pgdata

# Prod (docker-compose.yml). WireGuard-only; VPS nginx → 10.50.0.2:8081.
# Host 8080 is Pterodactyl Wings on this machine.
PUBLIC_APP_URL=https://crm.m2solution.ca
CORS_ORIGINS=https://crm.m2solution.ca
PROD_WEB_PUBLISH=10.50.0.2:8081

# Dev (docker-compose.dev.yml). Same Postgres instance as prod, database
# DEV_POSTGRES_DB. URLs stay local. SSH: -L 5173:127.0.0.1:5173
# Start prod `db` (and `db-init`) before the dev stack.
DEV_PUBLIC_APP_URL=http://localhost:5173
DEV_CORS_ORIGINS=http://localhost:5173
SEED_EMAIL=admin@m2solution.com
SEED_PASSWORD=changeme
COMPANY_NAME="M2 Solution"
COMPANY_EMAIL=billing@m2solution.com
COMPANY_ADDRESS=
COMPANY_PHONE=
